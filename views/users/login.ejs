<% layout("/layouts/boilerPlate") %>


    <div class="row mt-3 mb-5">
        <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
            <div class="card shadow-sm rounded-4 border-0 p-3 p-md-4">
                <div class="card-body">
                    <h2 class="fw-bold mb-4">Login on Heavenly</h2>
                    <form action="/login" method="post" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="username" class="form-label fw-semibold">Username</label>
                            <input name="username" id="username" placeholder="Enter Username" type="text"
                                class="form-control form-control-lg" required>
                        </div>
                        <div class="mb-4">
                            <label for="password" class="form-label fw-semibold">Password</label>
                            <input name="password" placeholder="Enter Password" type="password"
                                class="form-control form-control-lg" required>
                        </div>
                        <button class="btn btn-dark w-100 py-2 fw-bold add-btn">Login</button>
                    </form>
                    <div class="text-center mt-4">
                        <p class="text-muted small mb-0">Don't have an account? <a href="/signup"
                                class="text-primary text-decoration-none fw-semibold">Sign up</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>