<% layout("/layouts/boilerPlate") %>

    <div class="row mt-3 mb-5">
        <div class="col-12 col-md-8 offset-md-2">
            <div class="alert alert-danger rounded-4 border-0 shadow-sm p-4" role="alert">
                <h4 class="alert-heading fw-bold mb-3">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    <%= err.statusCode || 500 %> Error
                </h4>
                <hr>
                <p class="mb-0 fs-5">
                    <%= err.message %>
                </p>
                <div class="mt-4">
                    <a href="/listings" class="btn btn-outline-danger rounded-pill px-4 mt-2">Back to Listings</a>
                </div>
            </div>
        </div>
    </div>