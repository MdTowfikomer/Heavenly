<% layout("/layouts/boilerPlate") %>
    <style>
        @media (min-width: 2500px) {
            .col-show-ultra {
                width: 70% !important;
                margin-left: 15% !important;
            }

            .show-img {
                height: 60vh !important;
            }
        }
    </style>
    <div class="row mt-3">
        <div class="col-12 col-md-8 offset-md-2 col-show-ultra">
            <h3>
                <%= listing.title %>
            </h3>
        </div>

        <div class="card col-12 col-md-8 offset-md-2 show-card listing-card col-show-ultra">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_img">
            <div class="card-body">
                <p class="card-text"> <i><b>
                            Listed by <%= listing.owner.username %>
                        </b></i></p>
                <p>
                    <%= listing.description %>
                </p>
                <p>&#8377; <%= listing.price.toLocaleString("en-IN")%><br></p>
                <p>
                    <%= listing.country %>
                </p>
                <p>
                    <%= listing.location %>
                </p>
            </div>
            <button id="rzp-button" class="btn btn-dark">Book Now</button>
        </div>
        <br>

        <% if(curUser && curUser._id.equals(listing.owner._id)) {%>
            <div class="btns d-flex col-12 col-md-8 offset-md-2 mb-3 gap-3 col-show-ultra">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4 py-2 fw-semibold">Edit</a>

                <form method="post" action="/listings/<%=listing._id%>?_method=DELETE" class="m-0">
                    <button class="btn btn-dark delete-btn px-4 py-2 fw-semibold">Delete</button>
                </form>
            </div>
            <% } %>
    </div>
    <hr>

    <div class="col-12 col-md-8 offset-md-2 mb-3 col-show-ultra">
        <h3 class="fw-bold">Where you'll be</h3>
        <div id="map" class="rounded-4 shadow-sm border" style="width: 100%; height: 400px;"></div>
    </div>

    <div class="col-12 col-md-8 offset-md-2 col-show-ultra">
        <hr>
        <h4 class="fw-bold">Leave a Review</h4>
        <% //if(curUser) {%>
            <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3 mt-3">

                    <label for="rating" class="form-label fw-semibold">Rating</label>
                    <fieldset class="starability-grow">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                            aria-label="No rating." />
                        <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                        <label for="second-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                        <label for="second-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                        <label for="second-rate3" title="Average">3 stars</label>
                        <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                        <label for="second-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                        <label for="second-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <div>
                        <label for="comment" class="form-label fw-semibold">Comment</label>
                        <textarea id="comment" name="review[comment]" rows="4" cols="50" class="form-control rounded-3"
                            required placeholder="Write your experience..."></textarea>
                        <div class="invalid-feedback">
                            Please add a comment for the review!
                        </div>
                    </div>
                    <br>
                    <button class="btn btn-outline-dark rounded-pill px-4">Submit Review</button>
                </div>
            </form>
            <% // } %>

                <%if(listing.reviews.length> 0) {%>
                    <hr>
                    <h4 class="fw-bold mb-3">All Reviews</h4>
                    <div class="row g-3">
                        <% for(review of listing.reviews) {%>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4 p-2">
                                    <div class="card-body">
                                        <h5 class="card-title fw-bold mb-1">@<%= review.author.username %>
                                        </h5>
                                        <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>">
                                        </p>
                                        <p class="card-text text-muted mb-3">
                                            <%= review.comment %>
                                        </p>
                                        <form method="post"
                                            action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"
                                            class="mb-0">
                                            <button
                                                class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                    </div>
                    <% } %>
    </div>

    <script>
        const apiKey = "<%- geoapifyApiKey %>";
        const locationText = "<%- listing.location %>, <%- listing.country %>";

        fetch(`https://api.geoapify.com/v1/geocode/search?text=${encodeURIComponent(locationText)}&apiKey=${apiKey}`)
            .then(resp => resp.json())
            .then((geocodingResult) => {
                const mapDiv = document.getElementById('map');

                if (apiKey && geocodingResult.features.length > 0) {
                    const [lon, lat] = geocodingResult.features[0].geometry.coordinates;

                    // Initialize the map inside the callback
                    const map = L.map('map').setView([lat, lon], 13);

                    L.tileLayer('https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey={apiKey}', {
                        apiKey: apiKey
                    }).addTo(map);

                    L.marker([lat, lon]).addTo(map)
                        .bindPopup(`<b><%- listing.title %></b><br><%- listing.location %>`)
                        .openPopup();
                } else {
                    mapDiv.style.display = 'flex';
                    mapDiv.style.alignItems = 'center';
                    mapDiv.style.justifyContent = 'center';
                    mapDiv.style.backgroundColor = '#f8f9fa';

                    if (!apiKey) {
                        mapDiv.innerHTML = "<i><b>Map could not be loaded.</b> API Key is missing. Please check your .env file.</i>";
                    } else {
                        mapDiv.innerHTML = "<i>Location could not be found on the map.</i>";
                    }
                }
            })
            .catch(err => {
                console.error("Error loading map:", err);
                document.getElementById('map').innerHTML = "<i>An error occurred while loading the map. Check the console for details.</i>";
            });
    </script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        const rzpButton = document.getElementById('rzp-button');

        if (rzpButton) {
            rzpButton.onclick = async function (e) {
                try {
                    console.log("Initiating booking...");
                    rzpButton.disabled = true;
                    rzpButton.innerText = "Processing...";

                    // 1. CALL BACKEND TO CREATE ORDER
                    const response = await fetch(`/listings/<%= listing._id %>/book`);
                    
                    if (response.redirected) {
                        window.location.href = response.url;
                        return;
                    }

                    const contentType = response.headers.get("content-type");
                    if (!response.ok || !contentType || !contentType.includes("application/json")) {
                        const errorBody = await response.text();
                        console.error("Server returned non-JSON response:", errorBody);
                        throw new Error("Server error: Received HTML instead of JSON. Check your backend logs.");
                    }

                    const order = await response.json();
                    if (order.error) {
                        throw new Error(order.error);
                    }

                    // 2. DECLARING OPTION OBJ
                    const options = {
                        key: "<%= razorpayKeyId %>",
                        amount: order.amount,
                        currency: order.currency,
                        name: "<%= listing.title %>",
                        order_id: order.id,
                        description: "Booking for <%= listing.title %>",
                        image: "<%= listing.image.url %>",
                        handler: async function (response) {
                            try {
                                const verifyRes = await fetch(`/listings/<%= listing._id %>/verify`, {
                                    method: "POST",
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_signature: response.razorpay_signature
                                    })
                                });
                                
                                const verifyData = await verifyRes.json();
                                if (verifyData.status === "success") {
                                    window.location.href = `/listings/<%= listing._id %>`;
                                } else {
                                    alert("Payment verification failed: " + (verifyData.error || "Unknown error"));
                                }
                            } catch (vErr) {
                                console.error("Verification error:", vErr);
                                alert("Error verifying payment. Please contact support.");
                            }
                        },
                        prefill: {
                            name: "<%= curUser ? curUser.username : '' %>",
                            email: "<%= curUser ? curUser.email : '' %>",   
                        },
                        theme: {
                            color: "#3399cc"
                        }
                    }
                    const rzp = new Razorpay(options);
                    rzp.open();
                } catch (err) {
                    console.error("Payment error:", err);
                    alert(err.message || "Something went wrong. Please try again.");
                } finally {
                    rzpButton.disabled = false;
                    rzpButton.innerText = "Book Now";
                }
            }
        }
    </script>