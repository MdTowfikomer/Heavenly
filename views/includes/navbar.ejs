<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }

  .search-input {
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 1rem;
    width: 25rem;
  }

  @media (max-width: 768px) {
    .search-input {
      width: 15rem;
    }

    .search-container {
      margin: 0 auto;
    }
  }

  @media (max-width: 480px) {
    .search-input {
      width: 11rem;
      padding: 0.5rem 0.5rem 0.5rem 1rem;
      font-size: 0.85rem;
    }

    .search-btn {
      padding: 0 0.6rem;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>

    <!-- Search form always visible -->
    <div class="navbar-nav ms-auto search-container">
      <form role="search" class="d-flex" method="get" action="/listings">
        <input type="search" class="form-control me-2 search-input" name="q" placeholder="Search Destination"
          aria-label="Search">
        <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i><span class="d-none d-lg-inline">Search</span></button>
      </form>
    </div>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/trips/new">Trip Planner</a>
        <a class="nav-link" href="/listings/new">Add New Listing</a>
        <% if(!curUser){ %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</a>
          <% } if(curUser){ %>
            <a class="nav-link" href="/logout"><b>Log out</b></a>
            <% } %>
      </div>
    </div>
  </div>
</nav>